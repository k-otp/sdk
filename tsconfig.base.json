{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": [],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "isolatedDeclarations": true,
    "declaration": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,

    // Resolve the SDK's subpath exports from source (no build needed for
    // typecheck/tests). The published package resolves through `exports`.
    "paths": {
      "@k-otp/sdk": ["./packages/sdk/src/core/index.ts"],
      "@k-otp/sdk/core": ["./packages/sdk/src/core/index.ts"],
      "@k-otp/sdk/headless": ["./packages/sdk/src/headless/index.ts"],
      "@k-otp/sdk/contract": ["./packages/sdk/src/core/contract.ts"],
      "@k-otp/sdk/server": ["./packages/sdk/src/server/index.ts"],
      "@k-otp/sdk/react": ["./packages/sdk/src/react/index.ts"],
      "@k-otp/sdk/vue": ["./packages/sdk/src/vue/index.ts"],
      "@k-otp/sdk/svelte": ["./packages/sdk/src/svelte/index.ts"],
      "@k-otp/sdk/ui": ["./packages/sdk/src/ui/index.ts"],
      "@k-otp/sdk/ui/react": ["./packages/sdk/src/ui/react/index.ts"],
      "@k-otp/sdk/ui/vue": ["./packages/sdk/src/ui/vue/index.ts"],
      "@k-otp/sdk/ui/svelte": ["./packages/sdk/src/ui/svelte/index"]
    },

    "plugins": [{ "transform": "@ttsc/lint" }]
  }
}
