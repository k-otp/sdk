{
  "name": "k-otp-sdk-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Official JavaScript/TypeScript SDKs for the K-OTP Korean OTP API",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*"
    ],
    "catalog": {
      "@biomejs/biome": "2.5.14",
      "@orpc/client": "^1.15.4",
      "@orpc/contract": "^1.15.4",
      "@orpc/openapi-client": "^1.15.4",
      "@ttsc/lint": "^0.30.4",
      "@types/bun": "^1.4.2",
      "tsdown": "^0.23.0",
      "ttsc": "^0.30.4",
      "typescript": "^7.0.2"
    }
  },
  "scripts": {
    "build": "bun run --filter @k-otp/sdk-core build && bun run --filter @k-otp/sdk-server build",
    "typecheck": "bun run scripts/typecheck.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test packages",
    "gen:types": "bun run scripts/generate-types.ts",
    "check:openapi": "bun run scripts/generate-types.ts --check && bun test packages/sdk-core/test/contract-drift.test.ts",
    "sync:openapi": "bun run scripts/sync-openapi.ts",
    "check:pack": "bun run scripts/check-pack.ts",
    "size": "bun run scripts/size-report.ts",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build && bun run check:pack && bun run smoke:dist && bun run size",
    "smoke:dist": "node scripts/smoke-dist.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@ttsc/lint": "catalog:",
    "@types/bun": "catalog:",
    "tsdown": "catalog:",
    "ttsc": "catalog:",
    "typescript": "catalog:"
  }
}
