{
  "name": "@k-otp/sdk-core",
  "version": "0.0.0",
  "description": "Framework-agnostic K-OTP (Korean OTP API) client: issue and verify one-time passwords from browsers, SSR and edge runtimes.",
  "keywords": [
    "k-otp",
    "otp",
    "one-time-password",
    "sms",
    "alimtalk",
    "korea",
    "verification",
    "orpc"
  ],
  "license": "MIT",
  "author": "1990Company",
  "homepage": "https://github.com/k-otp/sdk/tree/main/packages/sdk-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k-otp/sdk.git",
    "directory": "packages/sdk-core"
  },
  "bugs": {
    "url": "https://github.com/k-otp/sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/k-otp.iife.min.js",
  "jsdelivr": "./dist/k-otp.iife.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./contract": {
      "import": {
        "types": "./dist/contract.d.ts",
        "default": "./dist/contract.js"
      },
      "require": {
        "types": "./dist/contract.d.cts",
        "default": "./dist/contract.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/internal.cjs"
      }
    },
    "./k-otp.iife.js": "./dist/k-otp.iife.js",
    "./k-otp.iife.min.js": "./dist/k-otp.iife.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsdown",
    "typecheck": "ttsc --noEmit -p tsconfig.json && ttsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/openapi-client": "catalog:"
  }
}
