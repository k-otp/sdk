{
  "name": "@k-otp/sdk-server",
  "version": "0.0.0",
  "description": "Server-side K-OTP (Korean OTP API) client for Node.js, Bun, Deno and edge runtimes: issue, verify, status, history, balance and templates with an sk_ secret key.",
  "keywords": [
    "k-otp",
    "otp",
    "one-time-password",
    "sms",
    "alimtalk",
    "korea",
    "verification",
    "server"
  ],
  "license": "MIT",
  "author": "1990Company",
  "homepage": "https://github.com/k-otp/sdk/tree/main/packages/sdk-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k-otp/sdk.git",
    "directory": "packages/sdk-server"
  },
  "bugs": {
    "url": "https://github.com/k-otp/sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsdown",
    "typecheck": "ttsc --noEmit -p tsconfig.json && ttsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@k-otp/sdk-core": "workspace:*"
  }
}
