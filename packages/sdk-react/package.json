{
  "name": "@k-otp/sdk-react",
  "version": "0.0.0",
  "description": "React hooks for the K-OTP (Korean OTP API) SDK: OtpProvider, useOtpIssue, useOtpVerify and an issue-to-verify flow hook with resend cooldown and idempotency key handling.",
  "keywords": [
    "k-otp",
    "otp",
    "one-time-password",
    "sms",
    "alimtalk",
    "korea",
    "verification",
    "react",
    "hooks"
  ],
  "license": "MIT",
  "author": "1990Company",
  "homepage": "https://github.com/k-otp/k-otp-sdk/tree/main/packages/sdk-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k-otp/k-otp-sdk.git",
    "directory": "packages/sdk-react"
  },
  "bugs": {
    "url": "https://github.com/k-otp/k-otp-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsdown",
    "typecheck": "ttsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@k-otp/sdk-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "react": "catalog:",
    "@types/react": "catalog:"
  }
}
