{
  "name": "@k-otp/sdk",
  "version": "1.4.0",
  "description": "Official K-OTP (Korean OTP API) SDK: issue and verify one-time passwords from browsers, SSR, edge and servers, with React, Vue and Svelte bindings, headless UI components with an optional theme, and a CDN bundle.",
  "keywords": [
    "k-otp",
    "otp",
    "one-time-password",
    "sms",
    "alimtalk",
    "korea",
    "verification",
    "orpc",
    "react",
    "vue",
    "svelte",
    "otp-input",
    "headless-ui"
  ],
  "license": "MIT",
  "author": "1990Company",
  "homepage": "https://k-otp.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k-otp/sdk.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/k-otp/sdk/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/core.cjs",
  "module": "./dist/core.js",
  "types": "./dist/core.d.ts",
  "unpkg": "./dist/k-otp.iife.min.js",
  "jsdelivr": "./dist/k-otp.iife.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./headless": {
      "import": {
        "types": "./dist/headless.d.ts",
        "default": "./dist/headless.js"
      },
      "require": {
        "types": "./dist/headless.d.cts",
        "default": "./dist/headless.cjs"
      }
    },
    "./contract": {
      "import": {
        "types": "./dist/contract.d.ts",
        "default": "./dist/contract.js"
      },
      "require": {
        "types": "./dist/contract.d.cts",
        "default": "./dist/contract.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./server": {
      "workerd": {
        "import": {
          "types": "./dist/server.d.ts",
          "default": "./dist/server.js"
        },
        "require": {
          "types": "./dist/server.d.cts",
          "default": "./dist/server.cjs"
        }
      },
      "worker": {
        "import": {
          "types": "./dist/server.d.ts",
          "default": "./dist/server.js"
        },
        "require": {
          "types": "./dist/server.d.cts",
          "default": "./dist/server.cjs"
        }
      },
      "edge-light": {
        "import": {
          "types": "./dist/server.d.ts",
          "default": "./dist/server.js"
        },
        "require": {
          "types": "./dist/server.d.cts",
          "default": "./dist/server.cjs"
        }
      },
      "deno": {
        "import": {
          "types": "./dist/server.d.ts",
          "default": "./dist/server.js"
        },
        "require": {
          "types": "./dist/server.d.cts",
          "default": "./dist/server.cjs"
        }
      },
      "browser": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.browser.js"
      },
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./kiota": {
      "browser": {
        "types": "./dist/kiota.d.ts",
        "default": "./dist/kiota.browser.js"
      },
      "import": {
        "types": "./dist/kiota.d.ts",
        "default": "./dist/kiota.js"
      },
      "require": {
        "types": "./dist/kiota.d.cts",
        "default": "./dist/kiota.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "default": "./dist/svelte.js"
    },
    "./ui": {
      "import": {
        "types": "./dist/ui.d.ts",
        "default": "./dist/ui.js"
      },
      "require": {
        "types": "./dist/ui.d.cts",
        "default": "./dist/ui.cjs"
      }
    },
    "./ui/react": {
      "import": {
        "types": "./dist/ui-react.d.ts",
        "default": "./dist/ui-react.js"
      },
      "require": {
        "types": "./dist/ui-react.d.cts",
        "default": "./dist/ui-react.cjs"
      }
    },
    "./ui/vue": {
      "import": {
        "types": "./dist/ui-vue.d.ts",
        "default": "./dist/ui-vue.js"
      },
      "require": {
        "types": "./dist/ui-vue.d.cts",
        "default": "./dist/ui-vue.cjs"
      }
    },
    "./ui/svelte": {
      "types": "./dist/ui-svelte/index.d.ts",
      "svelte": "./dist/ui-svelte/index.js",
      "default": "./dist/ui-svelte/index.js"
    },
    "./ui/theme.css": "./dist/ui/theme.css",
    "./k-otp.iife.js": "./dist/k-otp.iife.js",
    "./k-otp.iife.min.js": "./dist/k-otp.iife.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsdown && bun run ../../scripts/build-kiota.ts",
    "typecheck": "ttsc --noEmit -p tsconfig.json && ttsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "clean": "rm -rf dist",
    "prepublishOnly": "node -e \"const p=require('./package.json');const bad=Object.entries({...p.dependencies,...p.peerDependencies,...p.optionalDependencies}).filter(([,v])=>/^(catalog|workspace):/.test(String(v)));if(bad.length){console.error('Refusing to publish from the package directory: unresolved '+bad.map(([k,v])=>k+'@'+v).join(', ')+'. Publish the tarball from bun pm pack instead (docs/releasing.md).');process.exit(1)}\""
  },
  "dependencies": {
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/openapi-client": "catalog:",
    "@microsoft/kiota-abstractions": "1.0.0-preview.109",
    "@microsoft/kiota-bundle": "1.0.0-preview.106",
    "@microsoft/kiota-http-fetchlibrary": "1.0.0-preview.109",
    "@microsoft/kiota-serialization-json": "1.0.0-preview.109",
    "@microsoft/kiota-serialization-form": "1.0.0-preview.109",
    "@microsoft/kiota-serialization-multipart": "1.0.0-preview.109",
    "@microsoft/kiota-serialization-text": "1.0.0-preview.109"
  },
  "peerDependencies": {
    "react": ">=18",
    "svelte": ">=4",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
