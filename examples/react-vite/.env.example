# Copy to .env.local. Leave empty to run against the built-in mock API.
# A pk_ PUBLIC key only: its allowedOrigins must include http://localhost:5173.
# Never put an sk_ secret key in a VITE_* variable (it ends up in the bundle).
VITE_K_OTP_PUBLIC_KEY=
# Optional, defaults to https://api.k-otp.dev/v1
VITE_K_OTP_BASE_URL=
